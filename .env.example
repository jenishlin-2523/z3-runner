# Z3 Demo Runner — copy to .env and fill in. Never commit .env.

# The portal API (https). The runner only ever calls OUT to this address.
BACKEND_URL=https://z3portal.200-141-9-11.sslip.io

# This PC's identity. On the VPS:  cat /opt/zportal/.demo_worker_token
WORKER_TOKEN=

# Name shown in the portal ("Office runner online"). Letters, digits, - and _ only.
WORKER_ID=office-pc-01

# claude = build with Claude Code using the subscription login on this PC.   stub = plain template, no AI.
GENERATOR=claude

# Path or name of the Claude Code executable. Leave as "claude" when it is on PATH.
CLAUDE_BIN=claude
# Optional: force a model, e.g. opus / sonnet. Empty = Claude Code's default for the account.
CLAUDE_MODEL=

# Limits
MAX_JOB_MINUTES=45
MAX_FIX_ATTEMPTS=2
POLL_SECONDS=15
HEARTBEAT_SECONDS=60
KEEP_DAYS=7
ENVIRONMENT=production
